      {"name": "intro_paragraph",     "type": "text",   "default": "", "required": false, "help": "Korte intro-paragraaf bovenaan."},
      {"name": "hero_image_id",       "type": "text",   "default": "", "required": false, "help": "Media-id voor de hero afbeelding."},
      {"name": "testimonial_quote",   "type": "text",   "default": "", "required": false, "help": "Klantcitaat."},
      {"name": "testimonial_author",  "type": "text",   "default": "", "required": false, "help": "Naam onder klantcitaat."}
    ],
    "default_meta": {
