[
  {
    "name": "stukadoor-stad",
    "slug_pattern": "stukadoor-{stad_slug}",
    "description": "Lokale stukadoor-pagina per stad. Hoofd-SEO-driver voor local search.",
    "variables": [
      {"name": "stad",                "type": "text",   "default": "Amsterdam", "required": true,  "help": "Stadnaam zoals getoond in koppen."},
      {"name": "stad_slug",           "type": "text",   "default": "amsterdam", "required": true,  "help": "URL-slug van de stad (lowercase, geen spaties)."},
      {"name": "provincie",           "type": "text",   "default": "Noord-Holland", "required": false, "help": "Provincie voor structured data."},
      {"name": "prijs_range_m2",      "type": "text",   "default": "€18 - €32 per m²", "required": false, "help": "Indicatieprijs per m² voor de stad."},
      {"name": "service_radius_km",   "type": "number", "default": 25, "required": false, "help": "Service radius in km vanaf de stad."},
      {"name": "lokale_referenties",  "type": "text",   "default": "", "required": false, "help": "Korte zin met lokale klanten/projecten."},
