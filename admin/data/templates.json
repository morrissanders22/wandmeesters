  {
    "name": "basic-page",
    "slug_pattern": "{slug}",
    "description": "Algemene content-pagina zonder vaste structuur (over-ons, contact, beleid).",
    "variables": [
      {"name": "title",       "type": "text", "default": "Nieuwe pagina", "required": true,  "help": "Pagina titel (verschijnt als H1)."},
      {"name": "slug",        "type": "text", "default": "nieuwe-pagina", "required": true,  "help": "URL-slug."},
      {"name": "intro",       "type": "text", "default": "",              "required": false, "help": "Intro-paragraaf bovenaan."},
      {"name": "body",        "type": "text", "default": "",              "required": false, "help": "Hoofdtekst (paragraaf)."}
    ],
    "default_meta": {
      "title": "{{title}} | Wandmeesters",
      "description": "{{intro}}",
      "canonical": "/{{slug}}/",
      "robots": "index,follow"
    },
    "content_blocks": [
      {"type": "heading-h1", "props": {"text": "{{title}}"}},
      {"type": "paragraph",  "props": {"text": "{{intro}}"}},
      {"type": "paragraph",  "props": {"text": "{{body}}"}}
    ]
  }
