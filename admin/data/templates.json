        {"q": "Hoe lang duurt {{dienst}}?", "a": "Doorgaans duurt {{dienst}} {{doorlooptijd}}, afhankelijk van het oppervlak."},
        {"q": "Voor wie is {{dienst}} geschikt?", "a": "{{dienst}} is geschikt voor {{voor_wie}}."}
      ]}},
      {"type": "heading-h2", "props": {"text": "Vraag direct een offerte aan"}},
      {"type": "button",     "props": {"label": "Offerte voor {{dienst}}", "url": "/contact/", "style": "primary"}}
