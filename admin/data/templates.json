      "canonical": "/stukadoor-{{stad_slug}}/",
      "robots": "index,follow",
      "og_title": "Stukadoor {{stad}} | Wandmeesters",
      "og_description": "Professioneel stukwerk in {{stad}} en omgeving. Vraag direct uw offerte aan.",
      "keyword": "stukadoor {{stad}}",
      "hreflang": [{"lang": "nl", "url": "/stukadoor-{{stad_slug}}/"}]
    },
    "content_blocks": [
      {"type": "heading-h1", "props": {"text": "Stukadoor in {{stad}} voor muren & plafonds | Wandmeesters"}},
      {"type": "paragraph",  "props": {"text": "Op zoek naar een betrouwbare stukadoor in {{stad}}? Wandmeesters verzorgt al jarenlang strak stucwerk, latexspuitwerk en betoncire in {{stad}} en omgeving (service-radius ca. {{service_radius_km}} km). {{intro_paragraph}}"}},
      {"type": "cta-banner", "props": {"headline": "Direct een offerte voor {{stad}}", "subline": "Prijsindicatie: {{prijs_range_m2}}. Reactie binnen 1 werkdag.", "cta_label": "Vraag offerte aan", "cta_url": "/contact/"}},
      {"type": "heading-h2", "props": {"text": "Onze diensten in {{stad}}"}},
      {"type": "section-3col", "props": {
        "col1": [
          {"type": "heading-h3", "props": {"text": "Stucwerk"}},
          {"type": "paragraph",  "props": {"text": "Strak stucwerk op muren en plafonds in {{stad}}, klaar voor verf of behang."}},
          {"type": "link",       "props": {"label": "Meer over stucwerk", "url": "/diensten/stucwerk/"}}
        ],
        "col2": [
          {"type": "heading-h3", "props": {"text": "Latexspuiten"}},
          {"type": "paragraph",  "props": {"text": "Spuitwerk met latex voor een perfect egaal eindresultaat, ook in {{stad}}."}},
          {"type": "link",       "props": {"label": "Meer over latex spuiten", "url": "/diensten/latex-spuiten/"}}
        ],
        "col3": [
          {"type": "heading-h3", "props": {"text": "Betoncire"}},
          {"type": "paragraph",  "props": {"text": "Naadloze betonlook-afwerking voor moderne woningen in {{stad}}."}},
          {"type": "link",       "props": {"label": "Meer over betoncire", "url": "/diensten/betoncire/"}}
        ]
      }},
      {"type": "heading-h2", "props": {"text": "Werkgebied rond {{stad}}"}},
      {"type": "paragraph",  "props": {"text": "Wij werken in heel {{stad}} en alle omliggende buurten. {{lokale_referenties}}"}},
      {"type": "testimonial", "props": {"quote": "{{testimonial_quote}}", "author": "{{testimonial_author}}", "role": "Klant uit {{stad}}"}},
      {"type": "heading-h2", "props": {"text": "Veelgestelde vragen over stucwerk in {{stad}}"}},
      {"type": "faq-group",  "props": {"items": [
        {"q": "Wat kost een stukadoor in {{stad}}?", "a": "De prijs hangt af van het type werk en de oppervlakte. Voor {{stad}} hanteren wij een indicatief tarief van {{prijs_range_m2}}. Vraag een offerte aan voor exacte prijs."},
        {"q": "Hoe snel kunnen jullie aan de slag in {{stad}}?", "a": "Doorgaans plannen wij projecten in {{stad}} binnen 1-3 weken in, afhankelijk van het seizoen."},
        {"q": "Werken jullie ook in de omliggende plaatsen?", "a": "Ja, we werken in een straal van ca. {{service_radius_km}} km rond {{stad}} en hanteren geen voorrijkosten binnen ons werkgebied."}
      ]}},
      {"type": "heading-h2", "props": {"text": "Vraag een offerte aan"}},
      {"type": "paragraph",  "props": {"text": "Vul het offerteformulier in en wij nemen binnen 1 werkdag contact met u op voor een vrijblijvende prijsopgave."}},
      {"type": "button",     "props": {"label": "Offerte aanvragen", "url": "/contact/", "style": "primary"}}
    ]
  },
  {
